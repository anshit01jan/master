<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging is sufficient for the current local suite and CI-style evidence capture. -->
<!-- PR scope refresh note: comment-only touch to keep this logging config visible in PR #4. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss} %-5level %c - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>