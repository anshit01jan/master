# Authentication System Environment Variables Template
# Copy this file to .env and fill in the actual values

## Database Configuration
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scrum31_auth

## Mail Service Configuration (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@authsystem.local

## Application Configuration
APP_URL=https://localhost:8080
APP_SECRET_KEY=

## Security
JWT_SECRET=
RESET_TOKEN_EXPIRY_MINUTES=2
LOCKOUT_DURATION_SECONDS=60
MAX_LOGIN_ATTEMPTS=3

## Rate Limiting
RATE_LIMIT_IP_WINDOW_MINUTES=5
RATE_LIMIT_IP_MAX_ATTEMPTS=5
RATE_LIMIT_USERNAME_WINDOW_MINUTES=60
RATE_LIMIT_USERNAME_MAX_ATTEMPTS=10

## Logging
LOG_LEVEL=INFO
